{
  "name": "ai-research-os-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "gen:openapi": "cd ../backend && ALL_PROXY= all_proxy= PYTHONPATH=. python scripts/generate_openapi.py",
    "gen:types": "openapi-typescript openapi.json -o src/types/api.ts",
    "gen": "npm run gen:openapi && npm run gen:types"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3",
    "@tanstack/vue-query": "^5.62",
    "dompurify": "^3.4.12",
    "echarts": "^5.6",
    "element-plus": "^2.9",
    "marked": "^18.0.7",
    "pinia": "^2.2",
    "vue": "^3.5",
    "vue-echarts": "^7.0",
    "vue-router": "^4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0",
    "@vitejs/plugin-vue": "^5.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7",
    "vite": "^6.0",
    "vue-tsc": "^2.2"
  }
}
