# AI Research OS — Development Environment
APP_NAME=AI Research OS
DEBUG=True
ENV=development

DATABASE_URL=postgresql+asyncpg://airesearch:airesearch_dev@localhost:5432/airesearch

QDRANT_HOST=localhost
QDRANT_PORT=6333

LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=''

#ollama
#LLM_PROVIDER=ollama
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3.5-98k:latest

OLLAMA_EMBEDDING_MODEL=bge-m3

REDIS_URL=redis://localhost:6380/0

# ── 外部数据源（机器相关，按需修改）──────────────────────────
# akshare_mcp 独立 venv 目录（akshare 子进程数据层）
AKSHARE_MCP_DIR=/home/wsm/codes/akshare_mcp
# 云端 MCP 兜底层（Layer 3；留空则禁用该层）
# AKSHARE_CLOUD_MCP_URL=http://8.137.104.120:8088/mcp
# akshare MySQL 镜像（只读，A 股数据源）
AKSHARE_MYSQL_HOST=127.0.0.1
AKSHARE_MYSQL_PORT=3306
AKSHARE_MYSQL_USER=root
AKSHARE_MYSQL_PASSWORD=root
AKSHARE_MYSQL_DATABASE=akshare
# NewsNow MCP 服务脚本 + 上游地址
NEWSNOW_MCP_SERVER_PATH=/home/wsm/codes/newsnow/tools/mcp-server.ts
NEWSNOW_BASE_URL=https://newsnow.busiyi.world

SECRET_KEY=dev-secret-key-not-for-production
CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=data/uploads
